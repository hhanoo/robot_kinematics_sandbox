<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_trajectory</name>
  <version>0.1.0</version>
  <description>Joint / Cartesian trajectory generation (pure numpy, ROS-independent)</description>
  <maintainer email="woo980711@gmail.com">hhanoo</maintainer>
  <license>Apache-2.0</license>

  <!-- ========================================================= -->
  <!-- Build tool dependencies -->
  <!-- ========================================================= -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ========================================================= -->
  <!-- Core ROS2 dependencies -->
  <!-- ========================================================= -->
  <!-- * FK / IK core -->
  <depend>robot_kinematics</depend>

  <!-- * Python dependencies -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- ========================================================= -->
  <!-- Test dependencies -->
  <!-- ========================================================= -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ========================================================= -->
  <!-- Export build type -->
  <!-- ========================================================= -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
